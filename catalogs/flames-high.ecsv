# %ECSV 1.0
# ---
# datatype:
# - {name: Name, datatype: string, description: Name of the galaxy or the system}
# - {name: Alt_Name, datatype: string, description: Alternative name used in the literature of the galaxy or the system}
# - {name: RA, datatype: string, description: J2000 Right Ascension}
# - {name: DEC, datatype: string, description: J2000 Declination}
# - {name: Redshift, datatype: float64, description: Redshift}
