# - {name: mu, datatype: float64, description: Gravitational lensing factor}
# - {name: mu_err, datatype: float64, description: Uncertainty of gravitational lensing factor}
# - {name: Lens_ref, datatype: string, description: Reference(s) of gravitational lensing factor}
