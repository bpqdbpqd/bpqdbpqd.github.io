# %ECSV 1.0
# ---
# datatype:
# - {name: Name, datatype: string, description: 'Unique identifier of the region, galaxy or the system'}
# - {name: Alt_Name, datatype: string, description: Alternative name used in the literature of the galaxy or the system}
# - {name: RA, datatype: string, description: J2000 Right Ascension}
# - {name: DEC, datatype: string, description: J2000 Declination}
# - {name: Merger, datatype: string, description: Merger flag}
# - {name: Resolved, datatype: string, description: Resolved region flag}
# - {name: Host, datatype: string, description: Host of the system flag}
# - {name: Sys_Name, datatype: string, description: 'System name of merger, group, or resolved galaxy'}
# - {name: Redshift, datatype: float64, description: Redshift}
# - {name: Distance, unit: Mpc, datatype: float64, description: Luminosity distance}
# - {name: Type, datatype: string, description: Type(s) of the object}
# - {name: L_IR, unit: 1e+08 solLum, datatype: float64, description: Infrared luminosity}
# - {name: L_IR_err, unit: 1e+08 solLum, datatype: float64, description: Uncertainty of infrared luminosity}
# - {name: L_IR_flag, datatype: string, description: Flag of infrared luminosity}
# - {name: L_IR_ref, datatype: string, description: Reference of infrared luminosity data}
# - {name: L_FIR, unit: 1e+08 solLum, datatype: float64, description: Far-infrared luminosity}
# - {name: L_FIR_err, unit: 1e+08 solLum, datatype: float64, description: Uncertainty of far-infrared luminosity}
# - {name: L_FIR_flag, datatype: string, description: Flag of far-infrared luminosity}
# - {name: L_FIR_ref, datatype: string, description: Reference of far-infrared luminosity data}
# - {name: L_FUV, unit: 1e+08 solLum, datatype: float64, description: Far-ultraviolet lumonosity}
# - {name: L_FUV_err, unit: 1e+08 solLum, datatype: float64, description: Uncertainty of far-ultraviolet lumonosity}
# - {name: L_FUV_flag, datatype: string, description: Flag of far-ultraviolet lumonosity}
# - {name: L_FUV_ref, datatype: string, description: Reference of far-ultraviolet lumonosity data}
# - {name: L_24, unit: 1e+08 solLum, datatype: float64, description: 24 micron luminosity}
# - {name: L_24_err, unit: 1e+08 solLum, datatype: float64, description: Uncertainty of 24 micron luminosity}
# - {name: L_24_flag, datatype: string, description: Flag of 24 micron luminosity}
# - {name: L_24_ref, datatype: string, description: Reference of 24 micron luminosity data}
# - {name: lg_M_star, unit: log Msun, datatype: float64, description: Log stellar mass}
# - {name: lg_M_star_err, unit: log Msun, datatype: float64, description: Uncertainty of log stellar mass}
# - {name: lg_M_star_flag, datatype: string, description: Flag of log stellar mass}
# - {name: lg_M_star_ref, datatype: string, description: Reference of log stellar mass data}
# - {name: lg_M_hi, unit: log Msun, datatype: float64, description: Log neutral gas mass}
# - {name: lg_M_hi_err, unit: log Msun, datatype: float64, description: Uncertainty of log neutral gas mass}
# - {name: lg_M_hi_flag, datatype: string, description: Flag of log neutral gas mass}
# - {name: lg_M_hi_ref, datatype: string, description: Reference of log neutral gas mass data}
